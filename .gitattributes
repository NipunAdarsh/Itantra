*.onnx filter=lfs diff=lfs merge=lfs -text
*.int8.onnx filter=lfs diff=lfs merge=lfs -text
*.so filter=lfs diff=lfs merge=lfs -text
*.bz2 filter=lfs diff=lfs merge=lfs -text

# Model config/vocab files are opaque data consumed by native code, not
# human-edited text -- never let Git normalize their line endings. A CRLF
# conversion here silently corrupts sherpa-onnx's tokens.txt parsing
# since it relies on exact byte content.
app/src/main/assets/** -text
